{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "section", "quote", "note"],
        "properties": {
          "kind": { "type": "string", "enum": ["new", "conflict"] },
          "section": { "type": "string" },
          "quote": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    }
  }
}
