{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["headline", "highlights", "sources", "speed", "recommendations", "appImprovements", "retention", "questions"],
  "properties": {
    "headline": { "type": "string", "maxLength": 160 },
    "highlights": { "type": "array", "maxItems": 6, "items": { "type": "string", "maxLength": 220 } },
    "sources": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "verdict", "why"],
        "properties": {
          "source": { "type": "string", "maxLength": 60 },
          "verdict": { "type": "string", "enum": ["keep", "grow", "fix", "reduce", "drop"] },
          "why": { "type": "string", "maxLength": 220 }
        }
      }
    },
    "speed": { "type": "string", "maxLength": 300 },
    "recommendations": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["area", "action", "why", "effort"],
        "properties": {
          "area": { "type": "string", "enum": ["sources", "whatsapp", "linkedin", "ats", "scoring", "speed", "outcomes", "data", "system"] },
          "action": { "type": "string", "maxLength": 200 },
          "why": { "type": "string", "maxLength": 220 },
          "effort": { "type": "string", "enum": ["small", "medium", "large"] }
        }
      }
    },
    "appImprovements": { "type": "array", "maxItems": 5, "items": { "type": "string", "maxLength": 220 } },
    "retention": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "why"],
        "properties": {
          "category": { "type": "string", "maxLength": 40 },
          "why": { "type": "string", "maxLength": 220 }
        }
      }
    },
    "questions": { "type": "array", "maxItems": 3, "items": { "type": "string", "maxLength": 200 } }
  }
}
