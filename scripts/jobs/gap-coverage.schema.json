{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["results"],
  "properties": {
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "covered"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 10 },
          "covered": { "type": "boolean" }
        }
      }
    }
  }
}
